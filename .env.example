# Clyps na VPS (docker compose). Copie para .env e preencha o que está vazio.

# ── App web ──
# Valores públicos do projeto Supabase (podem ficar no front).
VITE_SUPABASE_URL=https://wnrncfkwwbzllyhlaebg.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_EvomATfVsVovLYvS-_yvtA_Jrj1OPD2

# :80 = HTTP no IP da VPS. Com domínio apontado para a VPS, use o domínio
# (ex.: clyps.seudominio.com) e o HTTPS é emitido automaticamente.
SITE_ADDRESS=:80
# Mude se as portas 80/443 já estiverem em uso por outro site na VPS.
HTTP_PORT=80
HTTPS_PORT=443

# ── Worker ──
SUPABASE_URL=https://wnrncfkwwbzllyhlaebg.supabase.co
# SECRETA. Supabase → Project Settings → API Keys → service_role (ou secret key).
SUPABASE_SERVICE_ROLE_KEY=

# Transcrição: API compatível com OpenAI /audio/transcriptions (timestamps por palavra)
STT_API_KEY=
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1

# LLM que escolhe os trechos: API compatível com OpenAI /chat/completions
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=

# Opcionais
# MOCK_AI=1              # testa tudo sem chaves de IA (transcrição e seleção simuladas)
# ENFORCE_CREDITS=1      # liga a cobrança de créditos

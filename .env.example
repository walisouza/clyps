# Clyps na VPS. Copie para .env. Do jeito que está, já sobe em modo de teste.

# ── Endereço ──
# :80 = HTTP no IP da VPS. Com domínio apontado para a VPS, use o domínio
# (ex.: clyps.seudominio.com) e o HTTPS é emitido automaticamente.
SITE_ADDRESS=:80
# Mude se as portas 80/443 já estiverem em uso por outro site na VPS.
HTTP_PORT=80
HTTPS_PORT=443

# ── IA ──
# MOCK_AI=1 simula a transcrição e a escolha dos trechos, para testar sem nada configurado.
# Apague a linha abaixo para usar a transcrição de verdade.
MOCK_AI=1

# Transcrição: o Speaches (Whisper) roda num container na própria VPS, sem chave e sem custo.
# Modelos (quanto maior, melhor e mais lento; precisa de mais RAM):
#   Systran/faster-whisper-small (padrão, ~1 GB de RAM) · Systran/faster-whisper-medium (~2,5 GB)
# SPEACHES_MODEL=Systran/faster-whisper-small

# IA de texto (opcional): escolhe os trechos e escreve títulos e legendas do post.
# Sem ela, o Clyps escolhe pela energia da fala e pelas frases, e a legenda usa o começo da fala.
# Qualquer serviço no padrão OpenAI. Exemplo com o Gemini (Google AI Studio):
# LLM_API_KEY=
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-3.8-flash

# Auphonic (auphonic.com → Account Settings → API Key): opção "Profissional" de
# tratamento de voz, que remove eco e ruído com IA. Gasta as horas de crédito da conta
# só com a duração dos clipes. Deixe vazio para não oferecer a opção.
AUPHONIC_API_KEY=
# Intensidade (dB; 100 = remoção completa, 0 = automático):
# AUPHONIC_DEVERB_AMOUNT=100
# AUPHONIC_DENOISE_AMOUNT=100

# Outras opções de transcrição (no lugar do Speaches):
# STT_PROVIDER=assemblyai   + ASSEMBLYAI_API_KEY=   (a mesma chave também libera o LLM Gateway, só em conta paga)
# STT_PROVIDER=openai       + STT_API_KEY= STT_BASE_URL= STT_MODEL=

# ── Opcionais ──
# ALLOW_SIGNUP=1         # por padrão só a primeira conta pode ser criada
# ENFORCE_CREDITS=1      # liga a cobrança de créditos
# MAX_DURATION_SECONDS=14400

# Clyps na VPS. Copie para .env e configure as chaves de IA antes de processar vídeos.

# ── Endereço ──
# :80 = HTTP no IP da VPS. Com domínio apontado para a VPS, use o domínio
# (ex.: clyps.seudominio.com) e o HTTPS é emitido automaticamente.
SITE_ADDRESS=:80
# Mude se as portas 80/443 já estiverem em uso por outro site na VPS.
HTTP_PORT=80
HTTPS_PORT=443

# ── IA ──
# Dados fictícios só são permitidos com NODE_ENV=test e MOCK_AI=1.
MOCK_AI=0

# Transcrição: API compatível com OpenAI /audio/transcriptions (timestamps por palavra)
STT_API_KEY=
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1

# LLM que escolhe os trechos: API compatível com OpenAI /chat/completions
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=

# ── Opcionais ──
# ALLOW_SIGNUP=1         # por padrão só a primeira conta pode ser criada
# ENFORCE_CREDITS=1      # liga a cobrança de créditos
# MAX_DURATION_SECONDS=14400

# ── Instagram (opcional; uma conta profissional vinculada a um usuário Clyps) ──
# Instagram API with Instagram Login; token com instagram_business_content_publish.
# Não exponha tokens no frontend nem faça commit do .env.
META_OWNER_USER_ID=
META_IG_USER_ID=
META_ACCESS_TOKEN=
# Informe uma versão ativa no painel do seu app Meta, no formato vNN.0.
META_GRAPH_VERSION=
PUBLIC_BASE_URL=https://clyps.seudominio.com
# Gere com: openssl rand -hex 32
MEDIA_SIGNING_SECRET=

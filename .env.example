# Clyps na VPS. Copie para .env. Do jeito que está, já sobe em modo de teste.

# ── Endereço ──
# :80 = HTTP no IP da VPS. Com domínio apontado para a VPS, use o domínio
# (ex.: clyps.seudominio.com) e o HTTPS é emitido automaticamente.
SITE_ADDRESS=:80
# Mude se as portas 80/443 já estiverem em uso por outro site na VPS.
HTTP_PORT=80
HTTPS_PORT=443

# ── IA ──
# MOCK_AI=1 simula a transcrição e a escolha dos trechos, para testar sem chaves.
# Para usar IA de verdade: apague a linha abaixo e preencha ASSEMBLYAI_API_KEY.
MOCK_AI=1

# AssemblyAI (assemblyai.com → Dashboard → API Keys). Uma chave faz duas coisas:
#  - transcreve a fala com o tempo de cada palavra (legendas sincronizadas);
#  - escolhe os trechos e escreve a legenda do post, pelo LLM Gateway da AssemblyAI.
ASSEMBLYAI_API_KEY=
# Modelo do LLM Gateway que escolhe os trechos (padrão: claude-sonnet-4-6).
# LLM_MODEL=claude-sonnet-4-6

# Auphonic (auphonic.com → Account Settings → API Key): opção "Profissional" de
# tratamento de voz, que remove eco e ruído com IA. Gasta as horas de crédito da conta
# só com a duração dos clipes. Deixe vazio para não oferecer a opção.
AUPHONIC_API_KEY=
# Intensidade (dB; 100 = remoção completa, 0 = automático):
# AUPHONIC_DEVERB_AMOUNT=100
# AUPHONIC_DENOISE_AMOUNT=100

# Alternativa à AssemblyAI: APIs no padrão OpenAI.
# STT_API_KEY=          # transcrição (/audio/transcriptions)
# STT_BASE_URL=https://api.openai.com/v1
# STT_MODEL=whisper-1
# LLM_API_KEY=          # escolha dos trechos (/chat/completions); se preenchida, substitui o LLM Gateway
# LLM_BASE_URL=https://api.openai.com/v1

# ── Opcionais ──
# ALLOW_SIGNUP=1         # por padrão só a primeira conta pode ser criada
# ENFORCE_CREDITS=1      # liga a cobrança de créditos
# MAX_DURATION_SECONDS=14400

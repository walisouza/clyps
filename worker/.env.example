# Supabase (Project Settings → API). A service role key NUNCA vai para o front.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Transcrição: qualquer API compatível com OpenAI /audio/transcriptions com timestamps por palavra
STT_API_KEY=
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1

# LLM que escolhe os trechos: qualquer API compatível com OpenAI /chat/completions
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=

# Opcionais
# MOCK_AI=1                 # testa o pipeline sem chaves de IA (transcrição e seleção simuladas)
# MAX_DURATION_SECONDS=14400
# CREDITS_PER_MINUTE=100
# ENFORCE_CREDITS=1         # liga a cobrança de créditos (modo SaaS)
# CAPTION_FONT=Inter
